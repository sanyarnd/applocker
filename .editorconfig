root = true

[*]
charset = utf-8
tab_width = 4
indent_size = 4
indent_style = space
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
# formatting is enforced by Spotless with palantir-java-format: ./gradlew spotlessApply
ij_continuation_indent_size = 8
ij_java_imports_layout = $*, |, *

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.sh]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2
